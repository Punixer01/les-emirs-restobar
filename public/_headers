# The dashboards act on a single click, so they must never be framed: an
# invisible iframe over a decoy page is exactly how those clicks get stolen.
/admin
  Cache-Control: no-cache, must-revalidate
  X-Frame-Options: DENY
  Content-Security-Policy: default-src 'self'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: blob:; connect-src 'self'
  Referrer-Policy: no-referrer

