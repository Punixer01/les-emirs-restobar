# Cloudflare Pages CONCATENATES every matching rule, it does not override.
# So a header set here must never be set again below with a different value —
# conflicting X-Frame-Options is treated as invalid by some browsers, which
# silently removes the protection instead of tightening it.

/*
  X-Content-Type-Options: nosniff
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  Permissions-Policy: geolocation=(), microphone=(), payment=(), interest-cohort=()

/
  Cache-Control: no-cache, must-revalidate
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN

/carte
  Cache-Control: no-cache, must-revalidate
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN

# The dashboards act on a single click, so they must never be framed: an
# invisible iframe over a decoy page is exactly how those clicks get stolen.
/admin
  Cache-Control: no-cache, must-revalidate
  X-Frame-Options: DENY
  Content-Security-Policy: frame-ancestors 'none'
  Referrer-Policy: no-referrer

/reception
  Cache-Control: no-cache, must-revalidate
  X-Frame-Options: DENY
  Content-Security-Policy: frame-ancestors 'none'
  Referrer-Policy: no-referrer

# The guest's pass and change link carry a token in the URL — keep it out of
# the Referer header sent to anywhere else.
/pass
  Cache-Control: no-cache, must-revalidate
  X-Frame-Options: DENY
  Referrer-Policy: no-referrer

/modifier
  Cache-Control: no-cache, must-revalidate
  X-Frame-Options: DENY
  Referrer-Policy: no-referrer

/assets/*
  Cache-Control: public, max-age=604800

/assets/media/*
  Cache-Control: public, max-age=2592000
