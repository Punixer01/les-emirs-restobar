# ---- Database (auto-set by Netlify DB / Neon) ----
NETLIFY_DATABASE_URL=postgres://user:pass@host/db?sslmode=require

# ---- Auth (staff access) ----
AUTH_SECRET=change-me-to-a-long-random-string
OWNER_CODE=VOTRE_CODE_DIRECTION
RECEPTION_CODE=VOTRE_CODE_RECEPTION

# ---- Email (Resend) ----
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
MAIL_FROM=Les Émirs <reservations@your-domain.tn>   # must be a Resend-verified domain
RESTAURANT_EMAIL=contact@your-domain.tn              # owner alert inbox
PUBLIC_BASE_URL=https://les-emirs-premium.netlify.app

# ---- SMS fallback (optional; used when a client has no email) ----
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# ---- Owner phone push (optional; generate with: npx web-push generate-vapid-keys) ----
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:contact@your-domain.tn

# ---- Owner phone alert via Telegram (optional, free) ----
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
